                                            &lt;span class="ast-qi-separator"&gt;&lt;/span&gt;
                                      &lt;/span&gt;
                  &lt;span class="asset-recipe-ingr-name-nwd"&gt;&lt;span&gt;Mayonesa kewpie&lt;/span&gt;&lt;/span&gt;
