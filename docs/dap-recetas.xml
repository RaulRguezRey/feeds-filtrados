                  &lt;span class="asset-recipe-ingr-amount-nwd"&gt;
                                                                  &lt;span class="ast-ingr-qnty"&gt;
                          5
                          &lt;abbr title="unidades"&gt;uds.&lt;/abbr&gt;
                        &lt;/span&gt;
                                            &lt;span class="ast-qi-separator"&gt;&lt;/span&gt;
                                      &lt;/span&gt;
                  &lt;span class="asset-recipe-ingr-name-nwd"&gt;&lt;span&gt;Lonchas de pavo &lt;/span&gt;&lt;/span&gt;
